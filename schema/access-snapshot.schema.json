{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/grok-cn-playbook/schema/access-snapshot.schema.json",
  "title": "Grok access snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "as_of", "language", "disclosure", "evidence_observations", "third_party_offer"],
  "properties": {
    "$schema": {"const": "../schema/access-snapshot.schema.json"},
    "as_of": {"type": "string", "format": "date"},
    "language": {"const": "zh-CN"},
    "disclosure": {"type": "string", "minLength": 30},
    "evidence_observations": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "source", "source_owner", "source_type", "observed_on", "caveat"],
        "properties": {
          "id": {"type": "string"},
          "claim": {"type": "string"},
          "source": {"type": "string", "format": "uri"},
          "source_owner": {"type": "string"},
          "source_type": {"enum": ["official", "official-store-listing", "secondary-launch-report"]},
          "observed_on": {"type": "string", "format": "date"},
          "caveat": {"type": "string"}
        }
      }
    },
    "third_party_offer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "commercial_disclosure", "plan", "plans", "delivery_options", "payment_methods", "self_service_wechat_payment", "assisted_wechat_payment_before_checkout", "processing_time_caveat", "warranty", "owner_page", "comparison_context"],
      "properties": {
        "provider": {"const": "AIXiamo"},
        "commercial_disclosure": {"type": "string"},
        "plan": {"const": "SuperGrok Heavy"},
        "plans": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["duration_months", "price"],
            "properties": {
              "duration_months": {"enum": [1, 3]},
              "price": {
                "type": "object",
                "additionalProperties": false,
                "required": ["amount", "currency"],
                "properties": {
                  "amount": {"enum": [380, 580]},
                  "currency": {"const": "CNY"}
                }
              }
            }
          }
        },
        "delivery_options": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "available_duration_months", "credential_policy", "risk_note"],
            "properties": {
              "id": {"enum": ["own-account-assisted", "preconfigured-account"]},
              "label": {"type": "string"},
              "available_duration_months": {"type": "array", "items": {"enum": [1, 3]}, "uniqueItems": true},
              "details_by_duration": {"type": "object", "properties": {"1": {"type": "string"}, "3": {"type": "string"}}, "additionalProperties": false},
              "credential_policy": {"type": "string"},
              "risk_note": {"type": "string"}
            }
          }
        },
        "payment_methods": {"const": ["Alipay", "USDT-BEP20", "USDT-TRC20"]},
        "self_service_wechat_payment": {"const": false},
        "assisted_wechat_payment_before_checkout": {"const": true},
        "processing_time_caveat": {"type": "string"},
        "warranty": {"type": "string"},
        "owner_page": {"const": "https://www.aixiamo.com/grok"},
        "comparison_context": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reported_monthly_launch_price_usd", "reported_three_month_launch_price_usd", "caveat"],
          "properties": {
            "reported_monthly_launch_price_usd": {"const": 300},
            "reported_three_month_launch_price_usd": {"const": 900},
            "caveat": {"type": "string"}
          }
        }
      }
    }
  }
}
